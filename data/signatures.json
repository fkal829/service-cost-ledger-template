    "s-claude": {
      "name": "Claude API",
      "category": "ai",
      "provider": "Anthropic",
      "billing": "prepaid",
      "env": [
        "ANTHROPIC_API_KEY"
      ],
      "deps": [
        "anthropic",
        "@anthropic-ai/sdk",
        "@ai-sdk/anthropic",
        "langchain-anthropic"
      ]
    },
    "s-gemini": {
